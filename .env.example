# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production-use-secrets-token-hex
MAX_CONTENT_LENGTH=52428800

# Redis Configuration (for Celery - Phase 2)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File Storage
UPLOAD_FOLDER=temp/uploads
CONVERTED_FOLDER=temp/converted
FILE_RETENTION_MINUTES=60

# Rate Limiting
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/2
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# Security (IMPORTANT: Change these in production!)
CSRF_ENABLED=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Application Settings
APP_NAME=Image Converter Pro
APP_URL=http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE_ERRORS=logs/errors.log
LOG_FILE_ACCESS=logs/access.log
LOG_FILE_CONVERSIONS=logs/conversions.log

# Production Notes:
# 1. Generate a secure SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# 2. Set SESSION_COOKIE_SECURE=True when using HTTPS
# 3. Update APP_URL to your production domain
# 4. Use a managed Redis service for production (not localhost)
# 5. Configure proper SSL/TLS certificates
